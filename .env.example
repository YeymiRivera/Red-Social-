# =============================================================================
# Variables de entorno de Red Social 777
# Lo leen: docker compose (contructor.yml / despliegue.yml) y `dotnet run`
# (Program.cs carga este archivo automáticamente). Está en .gitignore: no lo subas.
# Si cambias algo, vuelve a levantar:  docker compose -f contructor.yml up -d
# =============================================================================

# ----- Puertos publicados en el host -----------------------------------------
# 5290 = nginx (balanceador del backend). Es el puerto registrado en los proveedores.
# 5500 = frontend.
BACKEND_PORT=5290
FRONTEND_PORT=5500

# Base de datos del contenedor PostgreSQL.
# POSTGRES_PASSWORD es obligatorio: define un valor propio antes de levantar el proyecto.
POSTGRES_DB=RedsocialDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Credenciales OAuth. Déjalas vacías aquí y completa tus propios valores en .env.
# .env está ignorado por Git; nunca lo subas ni pegues estos valores en el chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# TikTok Login Kit - Sandbox.
# La URI debe ser HTTPS pública y terminar en "/".
# Ejemplo: https://<tu-url-https>/auth/tiktok/callback/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
